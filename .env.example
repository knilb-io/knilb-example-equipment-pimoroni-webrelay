# equipment-pimoroni-webrelay settings. Copy to .env and edit.
# Precedence: process environment > --env-file > ./.env > defaults.
# Empty values count as unset.

# Bind address and port. Port 80 matches a web relay; binding it needs the
# systemd unit's CAP_NET_BIND_SERVICE (or use 8000 when running by hand).
EQUIPMENT_PIMORONI_WEBRELAY_HOST=0.0.0.0
EQUIPMENT_PIMORONI_WEBRELAY_PORT=80

# Python log level.
EQUIPMENT_PIMORONI_WEBRELAY_LOG_LEVEL=INFO

# HTTP Basic password. Empty (the default) means no authentication. When set,
# any username is accepted with this password, as on a web relay.
EQUIPMENT_PIMORONI_WEBRELAY_PASSWORD=

# Default relay1=2 pulse length in seconds; pulseTime1 overrides one pulse.
EQUIPMENT_PIMORONI_WEBRELAY_PULSE_TIME_S=1.5

# Reported as timezoneOffset (seconds) and serialNumber. An empty serial number
# reports the Pi's Ethernet MAC address.
EQUIPMENT_PIMORONI_WEBRELAY_TIMEZONE_OFFSET_S=0
EQUIPMENT_PIMORONI_WEBRELAY_SERIAL_NUMBER=

# Automation HAT ANALOG channel (1, 2 or 3) read as digitalInput1.
EQUIPMENT_PIMORONI_WEBRELAY_INPUT_CHANNEL=1

# Automation HAT ANALOG channel wired to the supply for vin, other than the
# input channel. 0 means none, and vin reads "".
EQUIPMENT_PIMORONI_WEBRELAY_VIN_CHANNEL=0

# Input sampling: period, hysteresis thresholds (volts) and debounce samples.
# on when V >= ON_MIN_V, off when V <= OFF_MAX_V, hold in between.
EQUIPMENT_PIMORONI_WEBRELAY_SAMPLE_PERIOD_MS=20
EQUIPMENT_PIMORONI_WEBRELAY_ON_MIN_V=4.0
EQUIPMENT_PIMORONI_WEBRELAY_OFF_MAX_V=1.5
EQUIPMENT_PIMORONI_WEBRELAY_DEBOUNCE_SAMPLES=2

# Window for frequency1, in seconds: rising edges in the window / its length.
EQUIPMENT_PIMORONI_WEBRELAY_FREQUENCY_WINDOW_S=1.0

# Development only: serve a fake board instead of the HAT (same as `serve --fake`).
# FAKE_VOLTS is the input voltage, FAKE_VIN the supply, and FAKE_TOGGLE_S > 0
# flips the input between 0 V and 24 V every that many seconds.
EQUIPMENT_PIMORONI_WEBRELAY_FAKE=0
EQUIPMENT_PIMORONI_WEBRELAY_FAKE_VOLTS=0
EQUIPMENT_PIMORONI_WEBRELAY_FAKE_VIN=12.0
EQUIPMENT_PIMORONI_WEBRELAY_FAKE_TOGGLE_S=0
